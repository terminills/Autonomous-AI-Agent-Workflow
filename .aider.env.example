# Aider Environment Configuration
# Copy this file to .aider.env and customize for your setup
# DO NOT commit .aider.env to version control!

# ============================================================
# LOCAL MODEL CONFIGURATION (Recommended - Zero Cost!)
# ============================================================
# If using Ollama (see docs/LOCAL_MODELS_GUIDE.md):
OLLAMA_API_BASE=http://127.0.0.1:11434

# Ollama Performance Tuning (optional)
OLLAMA_NUM_PARALLEL=1              # Parallel requests (default: 1)
OLLAMA_MAX_LOADED_MODELS=1         # Keep only 1 model loaded
OLLAMA_NUM_CTX=8192                # Context window size (default: 2048)
OLLAMA_KEEP_ALIVE=5m               # How long to keep model loaded
# OLLAMA_NUM_GPU=1                 # Number of GPUs (if applicable)
# OLLAMA_GPU_LAYERS=35             # GPU layers (adjust for your GPU)

# If using LM Studio instead of Ollama:
# OPENAI_API_BASE=http://127.0.0.1:1234/v1

# ============================================================
# CLOUD API CONFIGURATION (Alternative - Requires API Keys)
# ============================================================
# Only needed if you want to use cloud models instead of local

# OpenAI Configuration (for GPT models)
# OPENAI_API_KEY=sk-your_openai_api_key_here

# Anthropic Configuration (for Claude models)
# ANTHROPIC_API_KEY=sk-ant-your_anthropic_api_key_here

# Azure OpenAI Configuration
# AZURE_OPENAI_API_KEY=your_azure_api_key_here
# AZURE_OPENAI_ENDPOINT=https://your-endpoint.openai.azure.com/

# DeepSeek API (budget cloud option)
# DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Groq Configuration (fast cloud inference)
# GROQ_API_KEY=gsk_your_groq_api_key_here

# ============================================================
# GITHUB INTEGRATION (Optional)
# ============================================================
# GitHub Token (for GitHub integration features)
# GITHUB_TOKEN=ghp_your_github_token_here

# ============================================================
# AIDER SETTINGS (Optional Overrides)
# ============================================================
# AIDER_AUTO_COMMITS=true
# AIDER_DIRTY_COMMITS=true
# AIDER_DARK_MODE=auto
# AIDER_PRETTY=true
# AIDER_SHOW_DIFFS=true
